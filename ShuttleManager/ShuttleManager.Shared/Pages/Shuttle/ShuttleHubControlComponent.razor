    }

    private async Task OpenLogsShuttle()
    {
        if (isAndroid)
            return;

        string path = Path.Combine(
            AppContext.BaseDirectory,
            "logs",
            Shuttle.IPAddress!);

        if (!Directory.Exists(path))
            Directory.CreateDirectory(path);

        Process.Start(new ProcessStartInfo
        {
            FileName = "explorer",
            Arguments = path,
            UseShellExecute = true
        });
    }
