@using System.Globalization
@using ShuttleManager.Shared.Models

<div class="card-body p-2">
    <div class="stats-grid">
        <div class="stat-item">
            <div class="stat-title">Рабочее время</div>
            <div class="stat-value">@FormatDate(Shuttle.LastActivity)</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Проходимость</div>
            <div class="stat-value">@Shuttle.TotalDist</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Загрузки</div>
            <div class="stat-value">@Shuttle.LoadCounter</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Выгрузки</div>
            <div class="stat-value">@Shuttle.UnloadCounter</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Уплотнений</div>
            <div class="stat-value">@Shuttle.CompactCounter</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Подъём</div>
            <div class="stat-value">@Shuttle.LiftUpCounter</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Спуск</div>
            <div class="stat-value">@Shuttle.LiftDownCounter</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Паллетов за время</div>
            <div class="stat-value">@Shuttle.LifetimePalletsDetected</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Время работы</div>
            <div class="stat-value">@Shuttle.TotalUptimeMinutes</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Проблем мотора</div>
            <div class="stat-value">@Shuttle.MotorStallCount</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Перегрузок подъёма</div>
            <div class="stat-value">@Shuttle.LifterOverloadCount</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Столкновений</div>
            <div class="stat-value">@Shuttle.CrashCount</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Сбои системы</div>
            <div class="stat-value">@Shuttle.WatchdogResets</div>
        </div>

        <div class="stat-item">
            <div class="stat-title">Низкий заряд батареи</div>
            <div class="stat-value">@Shuttle.LowBatteryEvents</div>
        </div>
    </div>
</div>

<style>
    .shuttle-stats {
        min-width: 260px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 10px;
    }

    .stat-item {
        border: 1px solid var(--border-color);
        padding: 8px;
        border-radius: 6px;
    }

    .stat-title {
        font-size: 12px;
        color: #6c757d;
    }

    .stat-value {
        font-size: 18px;
        font-weight: 600;
    }
</style>

@code {

    [Parameter]
    public Shuttle Shuttle { get; set; } = default!;

    private string FormatDate(DateTime date)
    {
        if (date == default)
            return "-";

        return date.ToString("HH:mm:ss", CultureInfo.InvariantCulture);
    }

}