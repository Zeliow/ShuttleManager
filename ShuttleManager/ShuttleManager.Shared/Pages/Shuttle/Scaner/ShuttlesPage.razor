@page "/"

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="card mb-3">
                <div class="card-header">
                    <h6 style="margin-bottom:0px; display:inline;">Сканирование сети</h6>
                    <label>[dark mode: </label>
                    <input class="form-check-input" type="checkbox" id="themeToggle" @ref="toggleElement" checked="@IsDarkMode" @onchange="OnDarkModeChanged" role="switch" />]
                </div>
                <div class="card-body">
                    <div class="row mb-1">
                        <div class="col-md-12">
                            <label for="baseIp" class="form-label">Базовый IP:</label>
                            <InputText id="baseIp" @bind-Value="baseIp" class="form-control" placeholder="192.168.40" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="port" class="form-label">Порт:</label>
                            <InputNumber id="port" @bind-Value="port" class="form-control" min="1" max="65535" />
                        </div>
                    </div>
                    <button @onclick="StartScan" class="btn btn-primary w-100 mb-3" disabled="@isScanning">
                        @(isScanning ? "Сканирование..." : "Найти устройства")
                    </button>

                    @if (isScanning)
                    {
                        <div class="alert alert-info">
                            <div class="spinner-border spinner-border-sm" role="status"></div>
                            Поиск на @(baseIp).@(startRange)-@(endRange):@(port)...
                        </div>
                    }
                    @if (foundDevices.Any())
                    {
                        <div>
                            <h6>Найденные устройства:</h6>
                            <div class="d-grid gap-2">
                                @foreach (var ip in foundDevices)
                                {
                                    <button class="btn @(IsAlreadyConnected(ip.ToString()) ? "btn-success" : "btn-outline-primary")"
                                            @onclick="() => HandleConnectClickIfNotConnected(ip.ToString())"
                                            disabled="@IsAlreadyConnected(ip.ToString())">
                                        @(IsAlreadyConnected(ip.ToString()) ? $"Подключен: {ip}" : $"Подключить: {ip}")
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    else if (scanCompleted && !isScanning && !foundDevices.Any())
                    {
                        <div class="alert alert-secondary">
                            Устройства не найдены.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-9">
            @if (_connectedShuttles.Any())
            {

                <ul class="nav nav-tabs mb-3">
                    @foreach (var (shuttle, index) in _connectedShuttles.Select((s, i) => (s, i)))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(index == activeTabIndex ? "active" : "")"
                               href="#" @onclick="() => SelectShuttle(index)">
                                Шаттл №@shuttle.ShuttleNumber
                                @if (shuttle.IsConnected)
                                {
                                    <span class="badge bg-success">●</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">●</span>
                                }
                            </a>
                        </li>
                    }
                </ul>

                @if (activeTabIndex >= 0 && activeTabIndex < _connectedShuttles.Count)
                {
                    var activeShuttle = _connectedShuttles[activeTabIndex];
                    <div class="tab-content">
                        <div class="tab-pane active">
                            <ShuttleHubControlComponent @key="activeShuttle.IPAddress" Shuttle="activeShuttle"
                                                        OnDisconnected="OnShuttleDisconnected" />
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info text-center" style="margin-top: 50px;">
                    <h5>Нет подключенных устройств</h5>
                    <p>Подключите устройство через сканер слева для управления.</p>
                </div>
            }
        </div>
    </div>
</div>